# Fill in at least ONE alert channel. ntfy is the easiest (no account, no password).

# --- ntfy push notifications (recommended) ---
# 1. Install the free "ntfy" app (Android: Play Store / F-Droid, iPhone: App Store).
# 2. Tap "+" and subscribe to the topic below (server: ntfy.sh).
# Anyone who knows the topic name can see your alerts, so keep it long and random.
NTFY_TOPIC=rewards-CHANGE-ME-to-something-random
NTFY_SERVER=https://ntfy.sh

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gmail (optional; needs a Google App Password, see README) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_TO=

# --- Browser ---
# Leave blank for Playwright's bundled Chromium, or set to "msedge" / "chrome"
# to use the installed browser (Edge often has an easier Microsoft sign-in).
BROWSER_CHANNEL=
REDEEM_URL=https://rewards.bing.com/redeem/in
